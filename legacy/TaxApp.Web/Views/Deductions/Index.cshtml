@model TaxApp.Web.Models.DeductionsViewModel
@{
    ViewBag.Title = "Deductions";
}

<h1>Deductions</h1>
<p class="lead">Keep a list of work-related deductions. They reduce your taxable income in the return summary.</p>

<section class="card">
    <table class="table">
        <thead>
            <tr><th>Description</th><th>Category</th><th class="num">Amount</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var d in Model.Items)
            {
                <tr data-testid="deduction-row" data-id="@d.Id">
                    <td>@d.Description</td>
                    <td>@EnumDisplay.Name(d.Category)</td>
                    <td class="num">@MoneyFormatter.Display(d.Amount)</td>
                    <td class="actions">
                        @using (Html.BeginForm("Delete", "Deductions", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", d.Id)
                            <button type="submit" class="link">Remove</button>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="4" class="muted" data-testid="no-deductions">No deductions yet.</td></tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2">Total deductions</th>
                <td class="num" data-testid="deductions-total" data-value="@MoneyFormatter.Raw(Model.Total)">@MoneyFormatter.Display(Model.Total)</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</section>

<h2>Add a deduction</h2>
@using (Html.BeginForm("Add", "Deductions", FormMethod.Post, new { @class = "card form" }))
{
    @Html.AntiForgeryToken()

    if (!ViewData.ModelState.IsValid)
    {
        <div class="validation" data-testid="validation-summary">
            @Html.ValidationSummary(false)
        </div>
    }

    <label for="Description">Description</label>
    @Html.TextBox("Description", Model.Input.Description, new { maxlength = "100" })

    <label for="Category">Category</label>
    @Html.DropDownList("Category", Model.Categories)

    <label for="Amount">Amount ($)</label>
    @Html.TextBox("Amount", Model.Input.Amount, new { type = "number", step = "0.01", min = "0" })

    <button type="submit" class="btn">Add deduction</button>
}
